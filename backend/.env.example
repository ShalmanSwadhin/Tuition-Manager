PORT=5000
NODE_ENV=development

# Local:      mongodb://127.0.0.1:27017/tuition-manager
# Production: your MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/tuition-manager

JWT_SECRET=change-this-to-a-long-random-string
# How many days a login lasts before signing in again (default 90)
SESSION_DAYS=90

# Frontend origin(s) allowed by CORS, comma-separated.
# Production: your Vercel URL, e.g. https://tuition-manager.vercel.app
CORS_ORIGIN=http://localhost:5173

# Number of proxy hops in front of the app (Render = 1). Default 1.
# TRUST_PROXY=1

# Largest file a teacher can upload, in MB. Files are stored in MongoDB
# (GridFS), so they count toward the database size (512 MB on Atlas M0).
# MAX_UPLOAD_MB=20

# Used only by the one-time seed script to create your admin account
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Your Name
